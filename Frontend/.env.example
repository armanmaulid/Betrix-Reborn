# ══════════════════════════════════════════════════════════════════════════════
# 🛡️ BETRIX REBORN // FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ══════════════════════════════════════════════════════════════════════════════

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port & Host Binding
PORT=3001
HOST=0.0.0.0

# Backend Fastify API Gateway Endpoints
# Client-side visible API base URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Server-to-Server Internal Backend API URL (for Route Handlers & Server Components)
BACKEND_INTERNAL_URL=http://localhost:3000/api/v1

# WebSocket / Realtime Stream Gateway
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Session Cookie Security Flag
# Set to false for local HTTP / LAN development (e.g. http://192.168.x.x:3001)
# Automatically enables on HTTPS in production
COOKIE_SECURE=false

# Next.js Verbose Logging & Telemetry
# Set NEXT_TELEMETRY_DISABLED=1 to silence anonymous telemetry pings
NEXT_TELEMETRY_DISABLED=1

# Enable/disable verbose fetch URL logging in terminal (true | false)
NEXT_PUBLIC_DEBUG_LOGS=false
