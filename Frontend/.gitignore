# ══════════════════════════════════════════════════════════════════════════════
# 🛡️ NEXT.JS 16 & FRONTEND GITIGNORE RULES
# ══════════════════════════════════════════════════════════════════════════════

# Dependencies & Package Managers
node_modules/
.pnpm-store/
.pnp
.pnp.js
package-lock.json
yarn.lock

# Next.js Build Outputs & Caches
.next/
out/
build/
dist/
.swc/

# TypeScript Build & Cache Artifacts
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Local Secrets
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Testing & Coverage Artifacts (Vitest & Playwright)
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/

# Debugging & Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Turborepo Cache
.turbo/

# OS Specific Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE, Editor & AI Assistants Configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
.claude/
.cursor/
.windsurf/
.gemini/

# Security, Certificates & Sensitive Keys
*.pem
*.key
*.cert
*.crt
