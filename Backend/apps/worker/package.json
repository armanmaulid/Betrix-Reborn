{
  "name": "@betrix/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:ws": "tsx watch src/ws-worker.ts",
    "dev:news": "tsx watch src/news-worker.ts",
    "dev:sync": "tsx watch src/sync-worker.ts",
    "dev:cleanup": "tsx watch src/cleanup-worker.ts",
    "dev:calendar": "tsx watch src/calendar-worker.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:ws": "node dist/ws-worker.js",
    "start:news": "node dist/news-worker.js",
    "start:sync": "node dist/sync-worker.js",
    "start:cleanup": "node dist/cleanup-worker.js",
    "start:calendar": "node dist/calendar-worker.js",
    "calendar:backfill": "tsx src/scripts/calendar-backfill.ts",
    "test": "vitest run --exclude '**/dist/**' --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@betrix/application": "workspace:*",
    "@betrix/config": "workspace:*",
    "@betrix/core": "workspace:*",
    "@betrix/domain": "workspace:*",
    "@betrix/infra": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
