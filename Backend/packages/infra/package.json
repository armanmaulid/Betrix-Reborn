{
  "name": "@betrix/infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drizzle": "./src/persistence/drizzle/schema.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --exclude '**/dist/**' --passWithNoTests",
