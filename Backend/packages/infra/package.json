{
  "name": "@betrix/infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/persistence/drizzle/schema.d.ts",
      "import": "./dist/persistence/drizzle/schema.js",
      "default": "./dist/persistence/drizzle/schema.js"
    }
  },
  "scripts": {
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "build": "tsc",
    "test": "vitest run --exclude '**/dist/**' --passWithNoTests",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx src/persistence/drizzle/migrate.ts",
    "db:backfill:d1": "tsx src/persistence/drizzle/d1-backfill-accounts.ts",
    "db:cutover:d1": "tsx src/persistence/drizzle/d1-cutover-invalidate.ts"
  },
  "dependencies": {
    "@betrix/config": "workspace:*",
    "@betrix/core": "workspace:*",
    "@betrix/domain": "workspace:*",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "dukascopy-node": "^1.50.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
