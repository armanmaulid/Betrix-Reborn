    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/persistence/drizzle/migrate.ts"
  },
  "dependencies": {
    "@betrix/config": "workspace:*",
    "@betrix/core": "workspace:*",
    "@betrix/domain": "workspace:*",
    "@upstash/redis": "^1.38.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "dukascopy-node": "^1.50.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
