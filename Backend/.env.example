# ==========================================
# 1. CORE SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated origin allow-list in production ('*' is rejected at boot).
CORS_ORIGIN=*
LOG_LEVEL=info
# Set true ONLY when the API runs behind a trusted reverse proxy / BFF so
# request.ip reflects X-Forwarded-For (rate-limit buckets + device fingerprint).
TRUST_PROXY=false

# ==========================================
# 2. DATABASE (POSTGRESQL) & REDIS CACHE
# ==========================================
DATABASE_URL=postgresql://betrix:betrixpass@localhost:5432/betrix_reborn

# Remote Postgres TLS: certificate verification is ON by default.
# Provide a CA (PEM inline via PGSSL_ROOT_CERT or a path via PGSSL_ROOT_CERT_PATH),
# or set PGSSL_REJECT_UNAUTHORIZED=false ONLY for local/docker topologies.
PGSSL_ROOT_CERT=
PGSSL_ROOT_CERT_PATH=
PGSSL_REJECT_UNAUTHORIZED=

# Redis (Upstash REST API via local SRH proxy)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_dev_token

# ==========================================
# 3. AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 1:1 Physical Device Binding Enforcement (Set to false for multi-account local testing / development)
DEVICE_ENFORCEMENT=true

# ==========================================
# 4. FINNHUB (MARKET DATA, WEBSOCKET & NEWS)
# ==========================================
FINNHUB_API_KEY=
FINNHUB_LOG_TICKS=false

# ==========================================
# 5. DUKASCOPY (HISTORICAL OHLC) & BROKER TIMEZONE
# ==========================================
BROKER_UTC_OFFSET=3

# ==========================================
# 6. AI GATEWAY (OPENAI / DEEPSEEK / GEMINI COMPATIBLE)
# ==========================================
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
GEMINI_API_KEY=
DEFAULT_MODEL=dahono/deepseek-v4-pro-0813

# ==========================================
# 7. MAILER (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Betrix <no-reply@betrix.io>

# ==========================================
# 8. RATE LIMITING
# ==========================================
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
